# Development example. Use production values in the deployment environment.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306
# Use REQUIRED for cloud MySQL with SSL, DISABLED for local Docker MySQL.
DB_SSL_MODE=REQUIRED

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production deployments may set these explicitly if handled by a reverse proxy.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# USE_X_FORWARDED_PROTO_HEADER=True
